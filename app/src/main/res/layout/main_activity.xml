<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- always full size, so showing the controls never resizes the surface -->
    <net.pgaskin.windy.WindyWallpaperView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/scrim_top"
        android:title="@string/app_name_short"
        android:titleTextColor="@android:color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- not shown, it only hosts the editor's dialogs -->
        <net.pgaskin.windy.CustomThemeView
            android:id="@+id/custom_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- edit, effects, presets, set wallpaper (filled in by MainActivity) -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nav_background"
            android:orientation="horizontal"
            android:paddingTop="6dp" />

    </LinearLayout>

    <!-- the custom theme editor, over the bottom of the preview -->
    <net.pgaskin.windy.EditorPanel
        android:id="@+id/editor_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:elevation="8dp"
        android:visibility="gone" />

</FrameLayout>
